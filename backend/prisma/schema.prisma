generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String?
  displayName String?  // Custom display name (can be changed)
  username    String?  // Username (unique in practice, not enforced by DB)
  country     String?  // Country name
  countryCode String?  // Country code (alpha-2)
  university  String?  // University
  gender      String?  // 'male', 'female', 'other'
  avatar      String   @default("adventurer") // DiceBear avatar style
  avatarSeed  String?  // Seed for avatar generation
  profileComplete Boolean @default(false) // Whether user has completed profile setup
  role        String   @default("user") // 'admin' | 'user' | 'guest'
  passwordHash String? // Hashed password for admin accounts
  banned      Boolean  @default(false) // Banned users cannot match/chat
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]
  savedConversations SavedConversation[]
  settings    UserSettings?
  wallet      Wallet?
  offersSent SaveOffer[] @relation("offersSent")
  offersReceived SaveOffer[] @relation("offersReceived")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username     String
  country      String?  // Country name (can override user's country)
  countryCode  String?  // Country code (can override user's country code)
  university   String?  // University (can override user's university)
  genderFilter String?  // 'male', 'female', 'all'
  gender       String?  // Gender (can override user's gender)
  avatar       String   @default("adventurer") // DiceBear avatar style (can override user's avatar)
  avatarSeed   String?  // Seed for avatar generation (can override user's avatar seed)
  status       String   @default("active") // 'active', 'matched', 'ended', 'inactive'
  chatroomId   String?  // Track current chatroom for session
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chatrooms    ChatroomMember[]

  @@index([status])
  @@index([genderFilter])
  @@index([chatroomId])
}

model Chatroom {
  id        String   @id @default(uuid())
  status    String   @default("active") // 'active', 'ended'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   ChatroomMember[]
  messages  Message[]
}

model ChatroomMember {
  id        String   @id @default(uuid())
  chatroomId String
  chatroom  Chatroom  @relation(fields: [chatroomId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  
  @@unique([chatroomId, sessionId])
  @@index([chatroomId])
  @@index([sessionId])
}

model Message {
  id        String   @id @default(uuid())
  chatroomId String
  chatroom  Chatroom  @relation(fields: [chatroomId], references: [id], onDelete: Cascade)
  senderId  String
  content   String
  imageUrl  String?  // For image messages
  type      String   @default("text") // 'text', 'image', 'video', 'gift', 'system'
  mediaPrice String?  // JSON bundle { items:[{key,qty,label,coins,amountMinor,emoji}], priceCoins, priceMinor, sellerUserId, mediaType }
  mediaUnlockKey String? // stable id linking live Message + SavedMessage copies of the same paid media
  mediaUnlockedAt DateTime? // set when a recipient purchases/unlocks this media
  mediaPreviewUrl String? // blurred low-res preview shown to recipients before unlock
  replyToId String?  // ID of the message being replied to
  replyTo   Message? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")
  createdAt DateTime @default(now())

  @@index([chatroomId])
  @@index([createdAt])
  @@index([replyToId])
  @@index([mediaUnlockKey])
}

model SavedConversation {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId     String?  // For unauthenticated users (session ID)
  title       String?  // Auto-generated or custom title
  partnerUsername String? // Username of the person they chatted with
  partnerInfo  String?  // JSON string with partner info (country, university, etc.)
  partnerUserId String? // If partner is authenticated
  partnerGuestId String? // If partner is unauthenticated
  currentUserId String? // Session ID of the user who saved this (for identifying own messages)
  messageCount Int      @default(0)
  lastMessageAt DateTime @default(now())
  status      String   @default("active") // 'active', 'ended', 'pending_reconnect'
  reconnectOffered Boolean @default(false) // Whether reconnection has been offered
  canReconnect Boolean @default(true) // Whether both parties agreed to reconnection
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    SavedMessage[]
  saveOffers  SaveOffer[]

  @@index([userId])
  @@index([guestId])
  @@index([lastMessageAt])
  @@index([status])
}

model SaveOffer {
  id          String   @id @default(uuid())
  conversationId String
  conversation SavedConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  offeredByUserId String? // If offered by authenticated user
  offeredByUser User?   @relation("offersSent", fields: [offeredByUserId], references: [id], onDelete: Cascade)
  offeredByGuestId String? // If offered by guest user
  offeredToUserId String? // If offered to authenticated user
  offeredToUser   User?   @relation("offersReceived", fields: [offeredToUserId], references: [id], onDelete: Cascade)
  offeredToGuestId String? // If offered to guest user
  status      String   @default("pending") // 'pending', 'accepted', 'declined'
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  @@index([conversationId])
  @@index([offeredToUserId])
  @@index([offeredToGuestId])
  @@index([status])
}

model SavedMessage {
  id                String   @id @default(uuid())
  conversationId    String
  conversation      SavedConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId          String   // ID of the sender (could be userId or guest session id)
  senderUsername    String?  // Username of the sender (optional, can be fetched from session)
  content           String
  imageUrl          String?  // For image messages
  type              String   @default("text") // 'text', 'image', 'video', 'gift', 'system'
  mediaPrice        String?  // JSON bundle (same shape as Message.mediaPrice)
  mediaUnlockKey    String?
  mediaUnlockedAt   DateTime?
  mediaPreviewUrl   String?  // blurred low-res preview shown to recipients before unlock
  replyToId         String?  // ID of the message being replied to
  createdAt         DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
  @@index([mediaUnlockKey])
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageSound         Boolean  @default(true)
  browserNotifications Boolean  @default(false)
  typingIndicators     Boolean  @default(true)
  showAvatars          Boolean  @default(true)
  showTimestamps       Boolean  @default(true)
  fontSize             String   @default("medium") // 'small' | 'medium' | 'large'
  chatTheme            String   @default("default")
  status               String   @default("online") // 'online' | 'busy' | 'away' | 'invisible'
  statusMessage        String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Core wallet ledger. Amounts are integer minor units (centavos for PHP)
// so there is never any float rounding. Never edit balances directly —
// always go through WalletService inside a transaction.
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // minor units, >= 0
  currency  String   @default("PHP")
  status    String   @default("active") // 'active' | 'frozen'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id             String   @id @default(uuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId         String
  type           String   // 'deposit' | 'withdraw'
  amount         Int      // minor units, > 0
  fee            Int      @default(0) // minor units
  adminCommission Int    @default(0) // admin commission (usually 20% of fee)
  status         String   @default("pending") // 'pending' | 'completed' | 'failed' | 'cancelled'
  provider       String   @default("demo") // 'demo' | 'paymongo' | ...
  providerRef    String?  // provider-side reference (checkout/payment/payout id)
  method         String?  // 'gcash' | 'maya' | 'card' | 'bank' ...
  destination    String?  // masked account for withdrawals (****1234)
  idempotencyKey String?  @unique // client-generated UUID per submit; retries return the same row
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// Admin wallet for tracking platform income
model AdminWallet {
  id        String   @id @default(uuid())
  balance   Int      @default(0) // minor units (centavos), platform income
  currency  String   @default("PHP")
  status    String   @default("active") // 'active' | 'frozen'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Platform-level configuration editable from the admin panel. Simple string
// key/value; values are typed on read (admin UI + ConfigService).
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Gift catalog. Seeded from backend/src/wallet/gift-catalog.ts on first boot,
// then editable from the admin panel (label, coins, minor amount, emoji, color,
// enabled, rank). Runtime lookups use GiftService (DB-first, hardcoded fallback).
model Gift {
  key         String   @id
  label       String
  coins       Int
  amountMinor Int
  emoji       String
  lucide      String
  color       String
  enabled     Boolean  @default(true)
  rank        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}